class Solution {
    public int[] productExceptSelf(int[] nums) {
        int ans[] = new int [nums.length];
        int pre = 1;
        int post = 1;
        for(int i=0;i<nums.length;i++){
            if(i>0){
                ans[i] = nums[i-1]*pre;
                pre = ans[i];
            } else 
                ans[i] = pre;
        }
        for(int i=nums.length-2;i>=0;i--){
            post *= nums[i+1];
            ans[i] *= post; 
        }
        return ans;
    }
}
