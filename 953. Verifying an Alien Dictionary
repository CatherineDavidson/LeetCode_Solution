class Solution {
    public static boolean checkOrder(String a, String b, int arr[]){
        for(int i=0;i<a.length();i++){
            if(i>=b.length()) return false;
            if(a.charAt(i)==b.charAt(i)) continue; 
            if(arr[a.charAt(i)-'a']>arr[b.charAt(i)-'a']) return false;
            return true;
        }
        return true;
    }
    public boolean isAlienSorted(String[] words, String order) {
        int arr[] = new int[26];
        for(int i=0;i<26;i++)
            arr[order.charAt(i)-'a'] = i;
        for(int i=0;i<words.length-1;i++)
            if(!checkOrder(words[i],words[i+1],arr))
                return false;
        
        return true;
    }
}
