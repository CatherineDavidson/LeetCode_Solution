class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length==0)
            return 0;
        Set<Integer> hashset = new HashSet<>();
        for(int n:nums)
            hashset.add(n);
        int longsub = 1;
        for(int num:nums){
            int curr=1;
            if(hashset.contains(num-1))
                continue;
            while(hashset.contains(num+1)){
                curr++;
                num++;
            }
            if(curr>longsub)
                longsub = curr;
            if(longsub>nums.length/2)
                break;
        }
        return longsub;
    }
}
